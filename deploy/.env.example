# 실행 서버(macpro-debian)의 .env. compose.yaml과 같은 폴더에 두고 chmod 600으로 둔다.
# 값은 저장소에 쓰지 않는다. 뜻은 README.md의 ".env"를 본다.

# 제공처 키(KEDP001-D012)
ECOS_API_KEY=
KOSIS_API_KEY=
DATA_GO_KR_API_KEY=

# DB 계정 비밀번호(dell-debian에서 옮긴 계정과 같은 비밀번호)
kedp_go=
kedp_rust=

# postgres container의 관리 계정(POSTGRES_USER, POSTGRES_PASSWORD). volume을 처음 만들 때만 쓰인다.
KEDP_PG_SUPERUSER=
KEDP_PG_SUPERUSER_PASSWORD=

# 관리자 API를 쓸 수 있는 IP 또는 CIDR(쉼표로 나눈다). 비우면 관리자 API는 모두 403
KEDP_ADMIN_ALLOW_IPS=

# Docker 내부 network 대역(CIDR). 서버의 다른 network와 겹치지 않는 사설 대역
KEDP_NET_SUBNET=

# 바깥에 여는 nginx 포트. 비우면 80
KEDP_HTTP_PORT=

# 띄울 image tag(deploy/build.sh가 만든 tag)
KEDP_IMAGE_TAG=

# 백업 파일을 둘 폴더(절대 경로)
KEDP_BACKUP_DIR=
